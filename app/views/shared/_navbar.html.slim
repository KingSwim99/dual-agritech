/ ─── Navbar ─────────────────────────────────────────────────────────────────
nav.navbar.navbar-expand-lg.site-navbar.sticky-top data-controller="navbar"
  .container
    / Brand / Logo
    = link_to root_path, class: "navbar-brand p-0" do
      = image_tag "logos/DA-logo-banner.png", height: 50, alt: "Dual AgriTech"
    / Mobile toggler
    button.navbar-toggler type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation"
      span.navbar-toggler-icon
    / Collapsible content
    #siteNav.collapse.navbar-collapse
      / Nav links — centered between brand and CTAs
      - about_active = current_page?(site_about_ppafi_path) || current_page?(site_about_dffsi_path) || current_page?(site_about_bffsi_path)
      ul.navbar-nav.mx-auto.mb-2.mb-lg-0
        li.nav-item
          = link_to "Home", root_path, class: "nav-link #{ 'active' if current_page?(root_path) }"
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" class="#{'active' if about_active}"
            | About
          ul.dropdown-menu
            li = link_to "PPAFI", site_about_ppafi_path, class: "dropdown-item #{'active' if current_page?(site_about_ppafi_path)}"
            li = link_to "DFFSI", site_about_dffsi_path, class: "dropdown-item #{'active' if current_page?(site_about_dffsi_path)}"
            li = link_to "BFFSI", site_about_bffsi_path, class: "dropdown-item #{'active' if current_page?(site_about_bffsi_path)}"
        li.nav-item
          = link_to "Gallery", site_gallery_path, class: "nav-link #{ 'active' if current_page?(site_gallery_path) }"
        li.nav-item
          = link_to "Partners", site_partners_path, class: "nav-link #{ 'active' if current_page?(site_partners_path) }"
        li.nav-item
          = link_to "Contact", site_contact_path, class: "nav-link #{ 'active' if current_page?(site_contact_path) }"
      / CTA Buttons
      .navbar-cta.d-flex.flex-column.flex-lg-row.gap-2
        = link_to "Donate Now", site_donate_path, class: "btn btn-donate-now"
        = link_to "Apply Now", site_apply_path, class: "btn btn-apply-now"
