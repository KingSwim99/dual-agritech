<!DOCTYPE html>
<html>
  <body>
    <h2>New Donation Inquiry</h2>
    <table cellpadding="6" cellspacing="0" border="1" style="border-collapse:collapse;">
      <tr><th align="left">Full Name</th><td><%= @donation_inquiry.name %></td></tr>
      <tr><th align="left">Email</th><td><%= @donation_inquiry.email %></td></tr>
      <tr><th align="left">Contact Number</th><td><%= @donation_inquiry.contact_number %></td></tr>
      <tr><th align="left">Organization</th><td><%= @donation_inquiry.organization.presence || "—" %></td></tr>
      <tr><th align="left">Message</th><td style="white-space:pre-wrap;"><%= @donation_inquiry.remarks %></td></tr>
      <tr><th align="left">Proof of Donation</th><td><%= @donation_inquiry.document.attached? ? @donation_inquiry.document.filename : "No attachment" %></td></tr>
      <tr><th align="left">Submitted At</th><td><%= @donation_inquiry.created_at.strftime("%B %d, %Y %I:%M %p UTC") %></td></tr>
    </table>
  </body>
</html>
